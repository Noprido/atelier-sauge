# Copiez ce fichier en ".env" et renseignez les valeurs. Ne commitez jamais ".env".

NODE_ENV=development
PORT=3000

# URL publique du site (sans slash final). Utilisée pour les liens canoniques, le sitemap et les e-mails.
SITE_URL=http://localhost:3000

# Secret de session : 32 caractères minimum, aléatoire.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Hash bcrypt du mot de passe administrateur (voir README : npm run hash-password "votre mot de passe").
# Gardez les guillemets simples : le hash contient des caractères "$".
ADMIN_PASSWORD_HASH=''

# Derrière un reverse proxy (Nginx, Caddy, plateforme PaaS) : nombre de proxys de confiance (souvent 1).
# Indispensable en production HTTPS pour que le cookie de session "secure" et l'IP du visiteur soient corrects.
TRUST_PROXY=

# Mettre "false" uniquement pour tester NODE_ENV=production en local sans HTTPS.
# COOKIE_SECURE=false

# Dossier de stockage des demandes (doit être sur un disque persistant). Par défaut : ./data
# DATA_DIR=/var/data/massage

# E-mails (SMTP ou fournisseur transactionnel). Sans SMTP_HOST, aucun e-mail n'est envoyé (message dans les logs).
SMTP_HOST=
SMTP_PORT=587
# true pour le port 465 (TLS direct), false pour 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Expéditeur affiché, ex. : Atelier Sauge <reservations@votre-domaine.fr>
MAIL_FROM=
# Adresse qui reçoit les notifications de nouvelles demandes
ADMIN_NOTIFY_EMAIL=
