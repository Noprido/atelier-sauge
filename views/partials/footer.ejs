<%
  const footerSocials = (site.socials || []).filter((s) => s.url);
%>
<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <p class="site-footer__brand"><%= site.business.name %></p>
      <p><%= site.business.tagline %> en France</p>
    </div>
    <ul class="site-footer__links" aria-label="Liens utiles">
      <li><a href="/mentions-legales">Mentions légales</a></li>
      <li><a href="/confidentialite">Politique de confidentialité</a></li>
      <li><a href="/conditions">Conditions de réservation</a></li>
      <% footerSocials.forEach((s) => { %>
      <li><a href="<%= s.url %>" target="_blank" rel="noopener noreferrer"><%= s.label %></a></li>
      <% }) %>
    </ul>
    <p class="site-footer__copy">© <%= year %> <%= site.business.name %></p>
  </div>
</footer>
